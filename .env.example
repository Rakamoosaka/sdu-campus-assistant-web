# Existing local SQLite file. PostgreSQL via Docker Compose remains supported.
DATABASE_URL=sqlite:///./sdu_campus.db
# Replace with a random secret for any shared environment. Do not change casually:
# existing mobile tokens/browser sessions were signed with the configured key.
JWT_SECRET=sdu-campus-course-demo-secret
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# true requires HTTPS; false is only for local HTTP development.
COOKIE_SECURE=false

# Optional AI. Leave the key blank for the built-in rule-based fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_REQUESTS_PER_MINUTE=10
